APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en_GB
# Daily FX rates: php artisan currency:fetch-rates (also scheduled 01:00)
# Daily FX rates (EUR base, includes INR). Fetched once per day via scheduler.
# CURRENCY_API_URL=https://open.er-api.com/v6/latest/EUR
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Live server DB (optional — for: php artisan db:compare-schema --remote)
# Use a read-only MySQL user if your host allows remote connections.
REMOTE_DB_HOST=
REMOTE_DB_PORT=3306
REMOTE_DB_DATABASE=
REMOTE_DB_USERNAME=
REMOTE_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production SMTP example (Laravel 12 uses MAIL_SCHEME — not MAIL_ENCRYPTION alone):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.hottubbuyer.co.uk
# MAIL_PORT=465
# MAIL_USERNAME=info@hottubbuyer.co.uk
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=info@hottubbuyer.co.uk
# MAIL_FROM_NAME="Hot Tub Buyer"

# Registration email OTP limits
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_VERIFY_ATTEMPTS=5
EMAIL_OTP_MAX_PER_EMAIL_DAY=3
EMAIL_OTP_MAX_PER_EMAIL_24H=5
EMAIL_OTP_MAX_PER_DEVICE_24H=3
EMAIL_OTP_MAX_PER_IP_24H=5
EMAIL_OTP_SKIP_MX_ON_LOCAL=true
# DISPOSABLE_EMAIL_DOMAINS=extra-temp-domain.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMS (FireText — https://firetext.co.uk/docs ) or Twilio
FIRETEXT_API_KEY=
FIRETEXT_FROM=HotTub
# Optional: send admin 2FA codes to this UK mobile (testing). Leave empty in production.
# FIRETEXT_ADMIN_2FA_TO=+447712345678

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Stripe (use test keys in development; live keys only on production server)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google Analytics 4
# Property ID + service account = admin dashboard Data API (/admin/analytics)
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=storage/app/google/analytics.json
# Measurement ID (G-XXXXXXXX) = browser tracking on public site (GA4 Realtime)
GOOGLE_ANALYTICS_MEASUREMENT_ID=

# Google Search Console (OAuth 2.0 — visit /admin/analytics/gsc-auth once to obtain refresh token)
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://hottubbuyer.co.uk/
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_OAUTH_CLIENT_JSON=client_secret.json
# Must match Authorized redirect URI in Google Cloud (defaults to APP_URL/admin/analytics/gsc-auth)
# GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=http://127.0.0.1:8000/admin/analytics/gsc-auth

# Auto-translate all pages via Google Translate when a non-English locale is selected
GOOGLE_TRANSLATE_ENABLED=true

# Registration anti-spam (accounts created only after OTP verification)
REGISTRATION_MAX_ACCOUNTS_PER_IP=3
REGISTRATION_MAX_ACCOUNTS_PER_DEVICE=2
REGISTRATION_MAX_OTP_REQUESTS_PER_IP_HOUR=10
REGISTRATION_MAX_OTP_VERIFY_ATTEMPTS=5
REGISTRATION_REQUIRE_DEVICE_COOKIE=false
REGISTRATION_REQUIRE_IMAGE_CAPTCHA=true
REGISTRATION_REQUIRE_MATH_CAPTCHA=true
REGISTRATION_MAX_SMS_PER_DEVICE_DAY=2
REGISTRATION_MAX_SMS_PER_HARDWARE_DAY=2
REGISTRATION_MAX_SMS_PER_PERSISTENT_ID_DAY=2
REGISTRATION_MAX_SMS_PER_IP_DAY=5

# Block Pakistan (IP, GPS, +92 phone, PK postcode). No secrets exposed to the browser.
GEO_RESTRICTIONS_ENABLED=false
GEO_BLOCKED_COUNTRIES=
GEO_BLOCK_PROXY_ON_AUTH=false
GEO_RESTRICTIONS_SKIP_LOCAL=false
GEO_IP_LOOKUP_CACHE_MINUTES=60

# OTP anti-bombing (checked before FireText API — blocks SMS cost)
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_APPEARANCE=always
TURNSTILE_SIZE=normal
OTP_DAILY_PLATFORM_LIMIT=20
OTP_DAILY_DEVICE_LIMIT=3
OTP_HOURLY_IP_LIMIT=8
OTP_HOURLY_PHONE_LIMIT=3
OTP_MIN_SECONDS_BETWEEN_DEVICE=60
OTP_BLOCK_ON_DEVICE_LIMIT=true
OTP_BLOCK_ON_CAPTCHA_FAIL=true
OTP_BLOCK_ON_HONEYPOT=true
OTP_HARDWARE_WINDOW_HOURS=6
OTP_HARDWARE_MAX_ATTEMPTS=5
OTP_HARDWARE_LOCK_HOURS=24
OTP_HARDWARE_LOCK_MESSAGE="You have tried multiple times. Please come back after 24 hours."
OTP_ABUSE_BLOCK_MESSAGE="You have tried multiple times. Please come back after 24 hours."

# Microsoft Clarity (User Behaviour on /admin/analytics)
CLARITY_PROJECT_ID=x087zurmb1
CLARITY_API_TOKEN=
# CLARITY_API_ENDPOINT=https://www.clarity.ms/export-data/api/v1/project-live-insights

# Google PageSpeed Insights (Technical Performance on /admin/analytics)
PAGESPEED_URL=https://www.hottubbuyer.co.uk
# PAGESPEED_API_KEY=
# PAGESPEED_CACHE_TTL=3600
